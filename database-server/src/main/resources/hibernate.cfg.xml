<!DOCTYPE hibernate-configuration PUBLIC
        "-//Hibernate/Hibernate Configuration DTD 3.0//EN"
        "http://www.hibernate.org/dtd/hibernate-configuration-3.0.dtd">
<hibernate-configuration>
    <session-factory>
        <!-- JDBC Database connection settings -->
        <property name="connection.driver_class">com.microsoft.sqlserver.jdbc.SQLServerDriver</property>
        <property name="connection.url">jdbc:sqlserver://127.0.0.1:1433;databaseName=sun-classic;encrypt=true;trustServerCertificate=true;</property>
        <!-- JDBC connection pool settings ... using built-in test pool -->
        <property name="connection.pool_size">20</property>
        <!-- Select our SQL dialect -->
        <property name="dialect">org.hibernate.dialect.SQLServerDialect</property>
        <!-- Additional settings
        <property name="hibernate.connection.autocommit">false</property> -->
        <property name="connection.isolation">2</property>
        <!--<property name="hibernate.temp.use_jdbc_metadata_defaults">false</property>-->
        <!-- Echo the SQL to stdout -->
        <property name="show_sql">true</property>
        <!-- Set the current session context -->
        <property name="current_session_context_class">thread</property>
        <!-- dbcp connection pool configuration -->
        <property name="hibernate.dbcp.initialSize">5</property>
        <property name="hibernate.dbcp.maxTotal">20</property>
        <property name="hibernate.dbcp.maxIdle">10</property>
        <property name="hibernate.dbcp.minIdle">5</property>
        <property name="hibernate.dbcp.maxWaitMillis">-1</property>
        <property name = "hbm2ddl.auto">none</property>
        <!-- Entity Mapping -->
        <mapping class = "com.valiantgaming.databaseserver.database.entity.account.Account"/>
        <mapping class = "com.valiantgaming.databaseserver.database.entity.EncryptionKey"/>
        <mapping class="com.valiantgaming.databaseserver.database.entity.server.ServerInfo"/>
    </session-factory>
</hibernate-configuration>